# ------------------------------------------------------------------
# RutaScan - environment configuration (copy to .env and edit)
# ------------------------------------------------------------------

# --- Database ------------------------------------------------------
# Local docker-compose default:
DATABASE_URL=postgresql+psycopg2://rutascan:rutascan@db:5432/rutascan
# Supabase (pooler) example:
# DATABASE_URL=postgresql+psycopg2://postgres.<project>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Neon example:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@ep-xxx.us-east-2.aws.neon.tech/rutascan?sslmode=require

POSTGRES_USER=rutascan
POSTGRES_PASSWORD=rutascan
POSTGRES_DB=rutascan

# --- Redis ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Security ------------------------------------------------------
# CHANGE THIS in production: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-me-in-production-0000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480          # 8h driver shift
REFRESH_TOKEN_DAYS=60
GRACE_TOKEN_DAYS=3                # offline grace window for the mobile app

# Key used by the SaaS operator to provision new tenant companies
PLATFORM_API_KEY=platform-dev-key-change-me

# --- Licensing / anti-piracy rules ---------------------------------
DEVICE_TTL_DAYS=14                # a device that hasn't heartbeated for N days frees its slot
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
MAX_TIMESTAMP_FUTURE_MINUTES=10   # device clock ahead of server => flagged
MAX_OFFLINE_AGE_DAYS=7            # scans older than this are flagged as stale
MAX_IMPLIED_SPEED_KMH=200         # teleport heuristic between two scans

# --- Uploads -------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=12

# --- Misc ----------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=*
SEED_DEMO_DATA=true
